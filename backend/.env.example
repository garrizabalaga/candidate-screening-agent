# Copiar a .env y ajustar. El .env no se sube al repositorio.
DATABASE_PATH=data/screening.db
AWS_REGION=eu-north-1
AWS_BEARER_TOKEN_BEDROCK=
# Modelo del agente. Perfiles "eu.*" para que los datos no salgan de la UE.
# Alternativas probadas: eu.amazon.nova-2-lite-v1:0 (más barato), eu.anthropic.claude-haiku-4-5-20251001-v1:0.
BEDROCK_AGENT_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# Voz (ElevenLabs Custom LLM): la misma clave se guarda como secreto en el agente de ElevenLabs.
VOICE_LLM_API_KEY=
# Agente de voz de ElevenLabs (su id, en la consola del agente).
ELEVENLABS_AGENT_ID=
# URL pública del backend (túnel): para el enlace de voz del mensaje de apertura.
PUBLIC_BASE_URL=
